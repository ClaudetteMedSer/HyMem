+        assert hy.conn.execute("SELECT rowid FROM vec_episodes").fetchone()[0] == 42
+        assert not hy.conn.in_transaction
+    finally:
+        if fence is not None:
+            core_db.deactivate_transaction_lease_fence(fence)
         hy.close()
 
 
