+        if action in (sqlite3.SQLITE_INSERT, sqlite3.SQLITE_UPDATE,
+                      sqlite3.SQLITE_DELETE) and table in _CLAIM_TABLES:
+            claim_writes.append((action, table, column, trigger))
+        return sqlite3.SQLITE_OK
