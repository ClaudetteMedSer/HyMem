+def _build_digest_summary_repair_request(
+    request: LLMRequest, rejected_summary: str,
+) -> LLMRequest:
+    """Frame one targeted revision without changing source bytes or limits.
+
+    JSON escaping keeps hostile delimiters inside their data fields; decoding
+    recovers both exact strings. The generated draft is separately labeled as
+    untrusted and cannot become additional provenance for the retained items.
+    """
+    returned_chars = len(rejected_summary.strip())
+    return replace(
+        request,
+        system=_DIGEST_SUMMARY_RECOVERY_TEMPLATE.format(
+            max_chars=SESSION_SUMMARY_MAX_CHARS,
+            returned_chars=returned_chars,
+            excess_chars=returned_chars - SESSION_SUMMARY_MAX_CHARS,
+        ),
+        user=json.dumps(
+            {
+                "original_generation_input": request.user,
+                "untrusted_rejected_summary": rejected_summary,
+            },
+            ensure_ascii=True,
+            separators=(",", ":"),
+        ),
+    )
+
