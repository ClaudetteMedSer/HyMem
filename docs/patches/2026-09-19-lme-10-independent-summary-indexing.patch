+SUMMARY_FAILURE_REASONS = frozenset({
+    "summary_output_cap", "summary_shape_failure", "summary_validation_failure",
+    "parse_failure", "output_truncated", "shape_failure", "prior_summary_gap",
+})
+_REASON = re.compile(r"[a-z0-9_]{1,80}\Z")
+_MAX_INTEGER = (1 << 63) - 1
+
