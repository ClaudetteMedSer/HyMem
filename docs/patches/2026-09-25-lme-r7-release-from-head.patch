+@pytest.mark.parametrize("child_size,depth,accepted", [(4500, 0, True), (8001, 0, False), (4500, 7, False)])
+def test_recovery_created_child_uses_same_whole_unit_and_depth_bounds(
+    monkeypatch, child_size, depth, accepted,
+):
