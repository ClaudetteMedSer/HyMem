+@pytest.mark.parametrize("flag", ["separate_summary", "prior_summary_is_stale"])
+@pytest.mark.parametrize("value", [None, 0, 1, "false", "true", "", [], {}])
+def test_mode_flags_require_exact_bools_before_calls(source, flag, value):
