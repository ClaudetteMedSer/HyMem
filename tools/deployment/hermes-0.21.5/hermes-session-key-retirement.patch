+def _unique_config_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+    """Reject ambiguous JSON without including configuration values in errors."""
+    result: dict[str, Any] = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError("Honcho config contains duplicate JSON keys")
+        result[key] = value
+    return result
+
+
+def _validate_session_key_replacements(value: Any) -> dict[str, str]:
+    """Validate exact physical-ID replacements; never coerce or sanitize them."""
+    if not isinstance(value, dict):
+        raise ValueError("sessionKeyReplacements must be a JSON object")
+    result: dict[str, str] = {}
+    for source, target in value.items():
+        if (
+            not isinstance(source, str)
+            or not isinstance(target, str)
+            or re.fullmatch(r"[A-Za-z0-9_-]+", source) is None
+            or re.fullmatch(r"[A-Za-z0-9_-]{1,100}", target) is None
+        ):
+            raise ValueError("sessionKeyReplacements requires exact safe session IDs; targets must be 1-100 characters")
+        result[source] = target
+    if len(set(result.values())) != len(result):
+        raise ValueError("sessionKeyReplacements targets must be unique")
+    if set(result).intersection(result.values()):
+        raise ValueError("sessionKeyReplacements cannot contain self-maps, chains, or cycles")
+    return result
+
+
+def _parse_session_key_replacements(host_obj: dict, root_obj: dict) -> dict[str, str]:
+    """First non-None map wins; an explicit empty host map overrides the root."""
+    source = host_obj.get("sessionKeyReplacements")
+    if source is None:
+        source = root_obj.get("sessionKeyReplacements")
+    return _validate_session_key_replacements({} if source is None else source)
+
